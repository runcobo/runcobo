require "./schema"

module Runcobo::Tasks
  class SchemaSnapshot
    HEADER = <<-TEXT
-- Generated by cobo db snapshot from db/migrations/. DO NOT EDIT.
-- Read-only reference. crsql and database setup read migrations directly.
-- Temporary schema names are displayed as public. No table data is included.


TEXT

    def initialize(@database : Database, schema : Schema? = nil, @output : IO = STDOUT)
      @schema = schema || Schema.new(@database)
    end

    def generate : Path
      paths = Migrations.new(@database).files
      raise ArgumentError.new("No migrations found") if paths.empty?
      url = @database.database_url("test")
      source = @schema.replay(url, paths) do |schema|
        header = HEADER.sub("db/migrations/", @database.settings.migration_directory.rstrip('/') + "/")
        header + @schema.dump(url, schema).gsub(schema, "public")
      end
      destination = @database.settings.root / @database.settings.snapshot_path
      Runcobo::Tasks.atomic_write(destination, source, 0o444)
      @output.puts "Generated read-only structure reference: #{@database.settings.snapshot_path}"
      destination
    end
  end
end
